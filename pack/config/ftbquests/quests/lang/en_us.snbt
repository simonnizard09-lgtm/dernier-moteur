	]
	"quest.3796038A910B1585.title": "Purifier l'eau en masse"
	"quest.37A6139041B9D56D.quest_desc": [
		"Un contremaître mécanique armé de missiles et de lasers. Coupe-le de ses bobines."
		"Il garde le &6Fragment du Noyau — Tempête&r et le Journal n°5."
	]
	"quest.37A6139041B9D56D.title": "Le Harbinger"
	"quest.37C2BBFBB7A6A683.title": "Chambre d'injection (×4)"
	"quest.38278DF26E619DC0.title": "Silicium"
	"quest.38CF9409C81CF551.quest_desc": [
		"Farmer's Delight : planche à découper, marmite, poêle. Varier ses repas donne de meilleurs effets que manger du pain toute la journée."
	]
