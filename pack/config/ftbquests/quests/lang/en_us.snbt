	"quest.354F65DE911C204A.title": "Journal n°4"
	"quest.360D9E1D84481645.quest_desc": [
		"&eControlling&r permet de chercher une touche et de voir les conflits (Options → Commandes)."
	]
	"quest.360D9E1D84481645.title": "Les touches"
	"quest.362CF25B7FF23F32.quest_desc": [
