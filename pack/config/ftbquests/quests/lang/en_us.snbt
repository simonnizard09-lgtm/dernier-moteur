	"quest.02776890BC20C380.quest_desc": [
		"&7&oIl tourne encore, lentement, sans axe.&r"
		""
		"Garde-le précieusement : les six fragments rallumeront le Moteur. Il reste dans la grille quand tu fabriques le Codex."
	]
	"quest.02776890BC20C380.title": "Fragment du Rouage"
	"quest.029A400F467F0E6B.quest_desc": [
		"La &eminimap&r (Xaero) est en haut à droite ; &eM&r ouvre la carte du monde."
		"Crée des points de passage avec &eB&r. À ta mort, un point est créé et ton équipement reste dans une &etombe&r (Corpse)."
	]
	"quest.029A400F467F0E6B.title": "Ne pas se perdre"
	"quest.032DCD5D48F7F25C.quest_desc": [
		"&7&oLe métal dont était fait le Noyau.&r"
		""
		"Infuseur métallurgique : &elingot d'acier&r + &eobsidienne raffinée&r (infusion)."
		"Composant de l'ère : Codex de l'Automate, graveur, Moteur."
	]
	"quest.032DCD5D48F7F25C.title": "L'alliage du Noyau"
	"quest.0393DF872B94318C.quest_desc": [
