	"quest.3BC49DDE018592AF.title": "Cube d'énergie"
	"quest.3BF636DBC0E70138.title": "L'œil de l'abysse"
	"quest.3DCF7575433ACE78.title": "La tour noire"
	"quest.3E570A3DA2A9A272.title": "Le mineur digital"
	"quest.3ED6C2B19F303570.title": "Fragment du Néant"
	"quest.3F018D7C88262C63.title": "Briques de haut fourneau"
	"quest.3F45EC53E566BD98.title": "Bobine basse tension"
	"quest.403388B6CDD65743.title": "Obsidienne raffinée"
	"quest.40436DB93B6D0E1C.quest_desc": [
		"Un feu de camp réchauffe (température) et fait bouillir l'eau."
		"Pose un &ebloc d'eau sale&r dessus… ou plutôt une bouteille : voir la quête suivante."
	]
	"quest.40436DB93B6D0E1C.title": "Un feu dans la nuit"
	"quest.430441746BF0E08C.quest_desc": [
		"&7&o« Et la vapeur devint courant. »&r"
		""
		"Branche ta machine à vapeur de Create sur une dynamo : rotation → énergie (FE)."
	]
	"quest.430441746BF0E08C.title": "La dynamo cinétique"
	"quest.448CBF1F0766EC50.quest_desc": [
		"Pose le contrôleur au centre d'une face, entoure le cube de boîtiers, puis fais un clic droit à main vide sur le contrôleur : il indique s'il est formé et ce qui lui manque."
	]
	"quest.448CBF1F0766EC50.title": "Assembler le Moteur"
	"quest.453F504ED2838935.title": "Compresseur d'osmium"
	"quest.45447ABC14C1C051.quest_desc": [
		"Au sommet du palais de l'aurore."
	]
	"quest.45447ABC14C1C051.title": "La Reine des neiges"
	"quest.45BFA72AF1470148.quest_desc": [
		"Minerais tirés du vide, sans creuser. Demande un processeur du Moteur."
	]
	"quest.45BFA72AF1470148.title": "La foreuse laser"
	"quest.46F078E29556874E.quest_desc": [
		"Multibloc géant : fond, allie et recycle. Les électrodes de graphite s'usent."
	]
	"quest.46F078E29556874E.title": "Le four à arc"
	"quest.47E2377AC22303BE.title": "La cité engloutie"
	"quest.483CE4031917758E.title": "Journal n°5"
	"quest.48AC212FFC3187E2.quest_desc": [
		"Le Gardien du Noyau est grand et appelle des serviteurs. Choisis un terrain plat et dégagé, loin de ta base, et reviens équipé (potions, pommes dorées, armure)."
	]
	"quest.48AC212FFC3187E2.title": "Préparer l'arène"
	"quest.4952DE0CA54807DE.quest_desc": [
		"Create: Central Kitchen permet d'automatiser les repas de Farmer's Delight."
	]
	"quest.4952DE0CA54807DE.title": "Cuisine automatisée"
	"quest.4985CCC6C06FE126.quest_desc": [
		"Crafts & Additions : fils et tiges métalliques."
	]
	"quest.4985CCC6C06FE126.title": "Le laminoir"
	"quest.4B4FA7969CBFC5AF.quest_desc": [
		"&7&o« C'est ici que nous fabriquions les gardiens. »&r"
	]
	"quest.4B4FA7969CBFC5AF.title": "L'usine ancienne"
	"quest.4C53E2D41B9FD7A1.title": "La citadelle en ruine"
	"quest.4CDB98EF846854C5.quest_desc": [
		"Motifs + fournisseur de motifs + assembleur moléculaire + CPU d'artisanat."
		"Branche des fournisseurs sur tes machines Create, IE et Mekanism : tout s'enchaîne."
	]
	"quest.4CDB98EF846854C5.title": "L'autocrafting"
	"quest.4CF860895999A26A.title": "Fragment de la Braise"
	"quest.4D2578E3F08633D9.title": "Journal n°3"
	"quest.4DA61B9412D1D7D0.title": "Le bras mécanique"
	"quest.4EC7B1831E7DB304.title": "L'électrum"
	"quest.4EE3BFF046CB4A85.title": "Carter de laiton"
	"quest.5064D314EABEF633.quest_desc": [
		"Infuse carbone, redstone, diamant, obsidienne raffinée… dans les métaux."
	]
	"quest.5064D314EABEF633.title": "L'infuseur métallurgique"
	"quest.517FAB6FD2A1E8E9.quest_desc": [
		"L'armure de laine protège du froid. L'armure de feuilles protège de la chaleur."
	]
	"quest.517FAB6FD2A1E8E9.title": "S'habiller pour l'hiver"
	"quest.5188F484C0D6733B.quest_desc": [
		"&7&oSans le Moteur, les bêtes de la nuit n'ont plus de maître.&r"
		""
		"&eMobs renforcés&r : ils s'équipent et deviennent plus dangereux avec le temps de jeu, mais ne cassent pas tes machines et ne volent rien."
		"&eSoif et température&r (Tough As Nails), &esaisons&r (Serene Seasons)."
		"Difficulté vanilla conseillée : &6Difficile&r."
	]
	"quest.5188F484C0D6733B.title": "Un monde hostile"
	"quest.52580842371BD0EA.quest_desc": [
		"Minerais concassés = plus de lingots. Premier doublement de ressources."
	]
	"quest.52580842371BD0EA.title": "Roues de concassage"
	"quest.5273D72D973E82BB.quest_desc": [
		"Trois têtes de feu dans le marais brûlant. Son sang ardent forge l'équipement ardent."
	]
	"quest.5273D72D973E82BB.title": "L'Hydre"
	"quest.5289D5FB0A867A1F.quest_desc": [
		"Sodium est déjà réglé. Baisse la &edistance de rendu&r (10-12) et la &edistance de simulation&r (6-8) dans les grosses bases."
		"&e/chunky&r peut prégénérer le monde ; &e/spark profiler&r trouve ce qui ralentit."
	]
	"quest.5289D5FB0A867A1F.title": "Performances"
	"quest.531D301B9E2E0866.quest_desc": [
		"L'inverse : FE → rotation, pour alimenter Create depuis ton réseau électrique."
	]
	"quest.531D301B9E2E0866.title": "Le moteur électrique"
	"quest.5406562D8F83F0CA.title": "Journal n°8"
	"quest.5413B090430DE7F0.title": "Gourde en or"
	"quest.542C3C789999EA45.title": "Récupérer la pluie"
	"quest.54A5F9D8E1BDAF4E.title": "L'œil du néant"
	"quest.5580413F7DB0714D.quest_desc": [
		"Cuis une bouteille d'eau sale dans un four ou un feu de camp pour la purifier."
	]
	"quest.5580413F7DB0714D.title": "Faire bouillir"
	"quest.56016D3C893169BD.title": "Repas complets"
	"quest.56444CACE41EAA2C.title": "Le jetpack"
	"quest.56D9323AE00BC418.quest_desc": [
		"&7&o« Nos premiers mécanismes étaient faits d'andésite et de fer. Humble. Solide. »&r"
		""
		"L'&ealliage d'andésite&r est la base de Create. L'ère de la &6Vapeur&r commence ici."
	]
	"quest.56D9323AE00BC418.title": "Un alliage étrange"
	"quest.5710A63B1F41C1FD.title": "Accepteur d'énergie"
	"quest.575B7DFCDA7B0EC1.quest_desc": [
		"&7&oUne étincelle prisonnière crépite à l'intérieur.&r"
	]
	"quest.575B7DFCDA7B0EC1.title": "Fragment de l'Étincelle"
	"quest.57650088C4D4B7B9.quest_desc": [
		"Dans la prison gelée."
	]
	"quest.57650088C4D4B7B9.title": "Maledictus"
	"quest.57DC698E2E348102.quest_desc": [
		"&7&o« Le premier gardien veillait sur l'atelier des rouages. »&r"
		""
		"Trouve une &echambre forgée&r dans les cavernes : une salle aux portes de fer, gardée par une armure vivante."
	]
	"quest.57DC698E2E348102.title": "La chambre du gardien"
	"quest.57EBEA1B3599E4A0.quest_desc": [
		"Invoque-le loin de tout. Son étoile sert à la Clé du Gardien."
	]
	"quest.57EBEA1B3599E4A0.title": "Le Wither"
	"quest.58B1D307947CA117.quest_desc": [
		"Codex de la Forge dans la grille. Pour les grands multiblocs d'IE."
	]
	"quest.58B1D307947CA117.title": "Ingénierie lourde"
	"quest.58E11C82107E01AF.quest_desc": [
		"Assemblage séquencé sur une &eplaque de laiton&r : mécanisme de précision, tube électronique, 250 mB d'eau, pressage."
	]
	"quest.58E11C82107E01AF.title": "Le mécanisme à vapeur"
	"quest.5938DB7985ABAD8A.quest_desc": [
		"&eSimple Backups&r sauvegarde ton monde toutes les 60 minutes (8 copies gardées), dans le dossier &esimplebackups&r de l'instance."
		"Avant une expérience risquée : &e/simplebackups backup start&r."
	]
	"quest.5938DB7985ABAD8A.title": "Sauvegardes automatiques"
	"quest.59B8B1AC1C33FEC9.title": "Le Nether"
	"quest.5A703CCF53FBBDFF.quest_desc": [
		"Brise ses boucliers, ignore les doubles, frappe l'original."
		"Elle garde le &6Fragment du Noyau — Étincelle&r et le Journal n°3."
	]
	"quest.5A703CCF53FBBDFF.title": "La Liche"
	"quest.5AB561545774140C.quest_desc": [
		"&7&o« Le dernier gardien n'est pas devenu fou. Il attend. »&r"
		""
		"Les six fragments (conservés), un processeur du Moteur, une étoile du Nether et un bloc d'alliage du Noyau."
	]
	"quest.5AB561545774140C.title": "La Clé du Gardien"
	"quest.5B4FC3CDC63A13D0.title": "Alliage infusé"
	"quest.5B98DA763447629F.quest_desc": [
		"&7&o« L'Étincelle fut la deuxième leçon. »&r"
		""
		"Le Codex est un &6catalyseur&r : il reste dans la grille quand tu fabriques le marteau et l'établi d'Immersive Engineering, et la bobine galvanique."
		"&6L'ère de l'Électricité est ouverte.&r"
	]
	"quest.5B98DA763447629F.title": "Le Codex de l'Étincelle"
	"quest.5B9E5CCE707A1DD4.quest_desc": [
		"Les jus désaltèrent mieux que l'eau."
	]
	"quest.5B9E5CCE707A1DD4.title": "Des jus de fruits"
	"quest.5BB4E2B246C653F1.quest_desc": [
		"Au fond du labyrinthe du Crépuscule."
	]
	"quest.5BB4E2B246C653F1.title": "Le Minoshroom"
	"quest.5C6C25BD01035570.title": "Composants d'acier"
	"quest.5D28D0F2686F3ADA.quest_desc": [
		"Codex de l'Étincelle dans la grille. Le marteau &eforme les multiblocs&r d'IE : frappe le bloc central d'une structure complète."
		"Le manuel d'IE (&eIngénieur's Manual&r, en jeu) montre chaque structure."
	]
	"quest.5D28D0F2686F3ADA.title": "Le marteau d'ingénieur"
	"quest.5DB0CC596E51AD65.quest_desc": [
		"Certaines recettes (alternateur, moteur électrique…) se font sur une grille d'&eassembleurs mécaniques&r."
		"&cAttention&r : n'y place jamais un &6Codex&r ; seule la table de craft le rend intact."
	]
	"quest.5DB0CC596E51AD65.title": "L'assembleur mécanique"
	"quest.5E11E1ECED25F765.quest_desc": [
		"La boussole d'explorateur trouve les &estructures&r, celle de la nature les &ebiomes&r."
	]
	"quest.5E11E1ECED25F765.title": "Boussoles d'explorateur"
	"quest.5EA4C4E1963573DB.quest_desc": [
		"Minerai ×2. Le début de la chaîne de traitement."
	]
	"quest.5EA4C4E1963573DB.title": "Chambre d'enrichissement"
	"quest.5ED28548D50F3716.quest_desc": [
		"&7&oLe premier composant qui n'était pas qu'une pièce de métal.&r"
	]
	"quest.5ED28548D50F3716.title": "Le tube électronique"
	"quest.5EFC4B6434DD5723.quest_desc": [
		"&7&oUne tour s'élève au-dessus des arbres du Crépuscule.&r"
	]
	"quest.5EFC4B6434DD5723.title": "La tour de la Liche"
	"quest.5FA0503F4B8648B3.title": "Bloc d'alliage du Noyau"
	"quest.6044F861E5B78401.quest_desc": [
		"Crafts & Additions : grille d'assembleurs mécaniques 5×5. Autre pont rotation → FE."
	]
	"quest.6044F861E5B78401.title": "L'alternateur"
	"quest.604D90FED0F597A4.title": "Le nid mécanique"
	"quest.6066CFDBAD8DB888.quest_desc": [
		"&7&oLes arbres, au moins, n'ont pas changé.&r"
	]
	"quest.6066CFDBAD8DB888.title": "Du bois et une table"
	"quest.60FA5E5154A0A691.quest_desc": [
		"&eIris Flywheel Compat&r fait fonctionner les machines animées de Create sous shaders."
		"Si une machine s'affiche mal : essaie un autre shaderpack, ou la commande &e/flywheel backend&r."
	]
	"quest.60FA5E5154A0A691.title": "Create et les shaders"
	"quest.611617D1166D09D8.title": "Four électrique"
	"quest.61213CF800ED8056.title": "Journal n°2"
	"quest.6237698312AB5892.quest_desc": [
		"&7&o« Les rivières se sont troublées avant midi. »&r"
		""
		"Boire de l'eau sale donne la &esoif&r (nausée). Remplis une bouteille à une source d'eau."
	]
	"quest.6237698312AB5892.title": "L'eau est trouble"
	"quest.63DC234BC73BE3ED.title": "Le labyrinthe"
	"quest.64A791BB164D220B.quest_desc": [
		"&7&oIléa Vaucor, la dernière ingénieure, a tout consigné.&r"
		""
		"Tu as reçu le &eCarnet de l'Ingénieur&r à ton arrivée. Il contient le &eGuide des ères&r et les &eJournaux&r de Vaucor, qui se débloquent quand tu les retrouves."
		"Perdu ? Cette quête t'en redonne un."
	]
	"quest.64A791BB164D220B.title": "Le Carnet de l'Ingénieur"
	"quest.64F7D51A1E231B73.title": "Four à alliages"
	"quest.6523F26DA0101A4E.quest_desc": [
		"Aquamirae : navires fantômes dans les océans glacés, et leur capitaine."
	]
	"quest.6523F26DA0101A4E.title": "Les terres gelées"
	"quest.653243621F3914DB.quest_desc": [
		"&eOptions → Options vidéo → Shader Packs…&r (ou touche &eO&r)."
		"Fournis : &6Complementary Reimagined&r (beau), &6BSL&r (alternative), &6MakeUp Ultra Fast&r (léger)."
		"Choisis-en un puis &eAppliquer&r."
	]
	"quest.653243621F3914DB.title": "Activer un shader"
	"quest.668164FE3B33CA95.quest_desc": [
		"La température dépend du biome, de l'altitude, de la saison et de ce qui t'entoure."
		"Trop chaud : ombre, eau, armure de feuilles. Trop froid : laine, feu, abri."
	]
	"quest.668164FE3B33CA95.title": "Lire la température"
	"quest.66A24B1EC783C240.quest_desc": [
		"Un ventilateur à travers de l'eau &elave&r, à travers du feu &efume/cuit&r, à travers de la lave &efond&r. Laver les minerais concassés donne des bonus."
	]
	"quest.66A24B1EC783C240.title": "Laver, fumer, fondre"
	"quest.67150B15030EDF41.title": "Le repaire de l'Hydre"
	"quest.6733F6256D7A8086.title": "Temple du désert"
	"quest.67A7E3B09D22E80A.quest_desc": [
		"L'énergie qui rallumera le Moteur. Le contrôleur demande un processeur du Moteur."
	]
	"quest.67A7E3B09D22E80A.title": "La fusion"
	"quest.67DB1874F24A8D07.title": "Cadre simple"
	"quest.68311DE8C15EEEDF.quest_desc": [
		"&7&oIl existe un monde voisin où la lumière ne se lève jamais tout à fait.&r"
		""
		"Creuse une mare d'eau de 2×2 entourée de fleurs, et jettes-y un &ediamant&r."
	]
	"quest.68311DE8C15EEEDF.title": "Le Crépuscule"
	"quest.684A5A64F834A5F3.title": "Générateur thermique"
	"quest.686FEC68841F465E.quest_desc": [
		"Le gardien de l'End."
	]
	"quest.686FEC68841F465E.title": "L'Ender Dragon"
	"quest.695E70A2C5FA26A3.quest_desc": [
		"Le bandeau en haut de l'écran décrit le bloc visé : énergie, progression, contenu."
	]
	"quest.695E70A2C5FA26A3.title": "Jade"
	"quest.6ABC47CD9865F7D3.title": "Broyeur"
	"quest.6B6BF2C768C38B7D.title": "Module aimant"
	"quest.6C0D3A6DD854C2FB.quest_desc": [
		"Minerai ×3 avec de l'oxygène (séparateur électrolytique)."
	]
	"quest.6C0D3A6DD854C2FB.title": "Chambre de purification (×3)"
	"quest.6C14CD1C9A7636B5.quest_desc": [
		"3×3×3 de briques, marteau sur le centre d'une face. Il donne du &ecoke&r et de la &ecréosote&r (bois traité)."
	]
	"quest.6C14CD1C9A7636B5.title": "Le four à coke"
	"quest.6C4168284DBACE61.title": "La foreuse"
	"quest.6C4F438714F4ABD9.quest_desc": [
		"Multibloc de broyage d'IE (voir le manuel). Coche quand il est formé."
	]
	"quest.6C4F438714F4ABD9.title": "Le broyeur"
	"quest.6CC256A9CCEDF995.quest_desc": [
		"&7&oSix éclats. Un seul Noyau.&r"
		""
		"Réunis-les dans ton inventaire."
	]
	"quest.6CC256A9CCEDF995.title": "Les six fragments"
	"quest.6CF3D63CAF0A0865.title": "Terre riche"
	"quest.6D2F8AF488B72FB5.title": "Réservoirs et pompes"
	"quest.6DC150F0A6820D42.title": "Le contrôleur du Moteur"
	"quest.6F1FC09672F809A8.quest_desc": [
		"Sous la pyramide maudite."
	]
	"quest.6F1FC09672F809A8.title": "L'Ancient Remnant"
	"quest.7074E98EEA52C6DA.quest_desc": [
		"&7&o« La Forge fut la troisième leçon : fondre, séparer, recomposer. »&r"
		""
		"Il déverrouille le &eboîtier en acier&r et l'&einfuseur métallurgique&r de Mekanism, et l'&eingénierie lourde&r d'IE."
		"&6L'ère de l'Industrie lourde est ouverte.&r"
	]
	"quest.7074E98EEA52C6DA.title": "Le Codex de la Forge"
	"quest.70841150813DCA42.title": "Un vrai repas"
	"quest.71088EC2B6039852.title": "Moudre"
	"quest.72132A53B98BBC93.quest_desc": [
		"Les mobs renforcés s'équipent au fil du temps. Fais de même."
	]
	"quest.72132A53B98BBC93.title": "Protection"
	"quest.72691BDEA00C8411.quest_desc": [
		"Le sommet du traitement : minerai ×5. Une vraie usine."
	]
	"quest.72691BDEA00C8411.title": "Chambre de dissolution (×5)"
	"quest.72AA78BB5FBF4155.title": "Récolte automatique"
	"quest.72E12341C6888938.title": "Forteresse illageoise"
	"quest.73813E2057E34AD6.title": "La marmite"
	"quest.7396855FED952EF2.quest_desc": [
		"Dans Prism Launcher : &e6 à 10 Go&r (12 Go maximum avec Distant Horizons). Plus n'est pas mieux : le ramasse-miettes ralentit."
		"Le README du dépôt donne les arguments JVM conseillés."
	]
	"quest.7396855FED952EF2.title": "La mémoire"
	"quest.73DB58497B67F27F.quest_desc": [
		"Sur son navire fantôme, dans les mers gelées."
	]
	"quest.73DB58497B67F27F.title": "La capitaine Cornelia"
	"quest.73DF53C6466DE12E.title": "Le déployeur"
	"quest.745F55AF2495989C.quest_desc": [
		"&7&o« La vapeur fut notre premier grand souffle. »&r"
		""
		"Chaudière (réservoirs + brûleurs) + machines à vapeur = énormément de rotation."
	]
	"quest.745F55AF2495989C.title": "La machine à vapeur"
	"quest.74E74243C77ADEC5.quest_desc": [
		"Proposé au premier lancement, désactivé par défaut. Pour l'activer plus tard : supprime &epackwiz.json&r dans le dossier minecraft de l'instance et relance (voir README)."
	]
	"quest.74E74243C77ADEC5.title": "Distant Horizons (optionnel)"
	"quest.753A8DBB1DDE2456.quest_desc": [
		"Latex → caoutchouc sec (unité de traitement du latex) → plastique (four)."
	]
	"quest.753A8DBB1DDE2456.title": "Le plastique"
	"quest.76FEAC322DBFD737.title": "Journal n°6"
	"quest.770BCB452E8AC4FC.title": "Un donjon de YUNG"
	"quest.7763BD8FD36A49B3.quest_desc": [
		"Les coffres des donjons contiennent parfois des &eartefacts&r (ici : chaussures de course)."
	]
	"quest.7763BD8FD36A49B3.title": "Un artefact"
	"quest.7A03F25D3FB1E692.quest_desc": [
		"Active les waystones trouvées dans le monde, ou fabrique les tiennes. Voyager coûte de l'XP selon la distance."
	]
	"quest.7A03F25D3FB1E692.title": "Les pierres de passage"
	"quest.7A6C3EADFB6DA0B2.quest_desc": [
		"Les sacs Sophisticated Backpacks s'améliorent (fer, or, diamant…) et acceptent des modules (ramassage, tri, magnétisme…)."
	]
	"quest.7A6C3EADFB6DA0B2.title": "Un sac à dos"
	"quest.7A783D49911BDEA2.quest_desc": [
		"Pose-le contre un tronc : il en tire du latex."
